---
import { profile, stats } from '../data/resume';
---

<section class="section" id="about">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">01 · About</span>
      <h2 class="section-title">Building software <span class="gradient-text">people use.</span></h2>
    </div>

    <div class="grid">
      <div class="text">
        {profile.summary.map((p, i) => <p class="reveal from-left" style={`--i: ${i}`}>{p}</p>)}
        <p class="meta reveal from-left" style="--i: 2">
          <span>📍 {profile.location}</span>
          <span>🎓 University of Melbourne</span>
          <span>🗣️ Thai · English · Japanese</span>
        </p>
      </div>

      <div class="stats">
        {
          stats.map((s, i) => (
            <div class="card stat reveal scale" style={`--i: ${i}`}>
              <span class="num">
                <span data-count={s.value} data-decimals={s.decimals}>
                  {s.value.toFixed(s.decimals)}
                </span>
                {s.suffix}
              </span>
              <span class="label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .text p {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .text p:first-child {
    color: var(--text);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.95rem !important;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 22px;
  }

  .num {
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-size: 0.88rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
