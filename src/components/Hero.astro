---
import { profile } from '../data/resume';

const [first, last] = profile.name.split(' ');
---

<section class="hero" id="top">
  <div class="blobs" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
  </div>

  <div class="container hero-inner">
    <p class="status hero-in" style="--d: 0">
      <span class="pulse"></span> Open to software engineering internships
    </p>

    <h1 class="title" aria-label={`${profile.name}`}>
      <span class="line hero-in" style="--d: 1">Hi, I'm <span class="wave">👋</span></span>
      <span class="line name hero-in" style="--d: 2">
        <span class="gradient-text">{first}</span>
      </span>
      <span class="line name hero-in" style="--d: 3">{last}<span class="nick"> ({profile.nickname})</span></span>
    </h1>

    <p class="typed hero-in" style="--d: 4" aria-live="polite">
      <span class="prompt">&gt;</span>
      <span id="typed" data-roles={JSON.stringify(profile.roles)}>{profile.roles[0]}</span><span class="caret"></span>
    </p>

    <p class="lead hero-in" style="--d: 5">{profile.tagline}</p>

    <div class="cta hero-in" style="--d: 6">
      <a href="#projects" class="btn btn-primary">View my work →</a>
      <a href={profile.github} class="btn btn-ghost" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"
          ></path></svg
        >
        GitHub
      </a>
    </div>
  </div>

  <a href="#about" class="scroll-cue" aria-label="Scroll to About section">
    <span class="mouse"><span class="wheel"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
  }

  .blobs {
    position: absolute;
    inset: 0;
    z-index: -1;
    filter: blur(80px);
    opacity: 0.55;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    animation: float 18s ease-in-out infinite alternate;
  }

  .b1 {
    width: 520px;
    height: 520px;
    top: -120px;
    right: -80px;
    background: var(--accent);
  }

  .b2 {
    width: 420px;
    height: 420px;
    bottom: -100px;
    left: -120px;
    background: var(--accent-2);
    animation-duration: 22s;
    animation-delay: -6s;
  }

  .b3 {
    width: 300px;
    height: 300px;
    top: 40%;
    left: 45%;
    background: var(--accent-3);
    opacity: 0.6;
    animation-duration: 26s;
    animation-delay: -12s;
  }

  @keyframes float {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-60px, 50px) scale(1.12);
    }
    100% {
      transform: translate(40px, -30px) scale(0.95);
    }
  }

  .hero-in {
    animation: rise 1.1s var(--ease) both;
    animation-delay: calc(0.25s + var(--d) * 0.12s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(36px);
      filter: blur(8px);
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #34d399;
    animation: ping 1.8s var(--ease) infinite;
  }

  @keyframes ping {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  .title {
    margin: 0;
    font-size: clamp(2.8rem, 9vw, 6.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .line {
    display: block;
  }

  .line:first-child {
    font-size: 0.42em;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin-bottom: 14px;
    font-weight: 600;
  }

  .nick {
    font-size: 0.4em;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.4s ease-in-out 1.4s infinite;
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      transform: rotate(0);
    }
    10%,
    30% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  .typed {
    margin: 30px 0 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    color: var(--accent-2);
    min-height: 1.6em;
  }

  .prompt {
    color: var(--accent-3);
    margin-right: 8px;
  }

  .caret {
    display: inline-block;
    width: 10px;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--accent-2);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .lead {
    max-width: 620px;
    margin: 20px 0 0;
    font-size: 1.12rem;
    color: var(--muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .scroll-cue {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    animation: rise 1s var(--ease) 1.4s both;
  }

  .mouse {
    display: block;
    width: 26px;
    height: 42px;
    border: 2px solid var(--muted);
    border-radius: 14px;
    position: relative;
  }

  .wheel {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text);
    animation: scroll 1.8s var(--ease) infinite;
  }

  @keyframes scroll {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-height: 700px) {
    .scroll-cue {
      display: none;
    }
  }
</style>

<script>
  const el = document.getElementById('typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');
    let role = 0;
    let char = roles[0].length;
    let deleting = true;

    const step = () => {
      const word = roles[role];
      char += deleting ? -1 : 1;
      el.textContent = word.slice(0, char);

      let delay = deleting ? 40 : 80;
      if (!deleting && char === word.length) {
        deleting = true;
        delay = 2000;
      } else if (deleting && char === 0) {
        deleting = false;
        role = (role + 1) % roles.length;
        delay = 350;
      }
      setTimeout(step, delay);
    };
    setTimeout(step, 2600);
  }
</script>
