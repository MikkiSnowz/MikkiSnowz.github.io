---
import { education } from '../data/resume';
---

<section class="section" id="education">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">04 · Education</span>
      <h2 class="section-title">Where I've <span class="gradient-text">learned.</span></h2>
    </div>

    <div class="grid">
      {
        education.map((e, i) => (
          <article class="card edu reveal" style={`--i: ${i}`} data-tilt>
            <span class="period">{e.period}</span>
            <h3>{e.school}</h3>
            <p class="degree">{e.degree}</p>
            <ul class="highlights">
              {e.points.map((pt) => (
                <li>
                  <span aria-hidden="true">★</span> {pt}
                </li>
              ))}
            </ul>
            {e.subjects.length > 0 && (
              <>
                <p class="sub-head">Subjects</p>
                <ul class="tags">
                  {e.subjects.map((s) => (
                    <li class="tag">{s}</li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .edu {
    padding: 34px;
  }

  .period {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.82rem;
    color: var(--accent-2);
  }

  h3 {
    margin: 10px 0 4px;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .degree {
    margin: 0;
    color: var(--muted);
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    gap: 10px;
  }

  .highlights li {
    display: flex;
    gap: 10px;
    font-weight: 500;
  }

  .highlights span {
    color: #fbbf24;
  }

  .sub-head {
    margin: 26px 0 12px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .edu {
      padding: 26px;
    }
  }
</style>
