---
import { profile } from '../data/resume';

const year = new Date().getFullYear();
---

<section class="section" id="contact">
  <div class="container">
    <div class="card box reveal scale">
      <span class="eyebrow">06 · Contact</span>
      <h2 class="section-title">Let's build something <span class="gradient-text">together.</span></h2>
      <p class="lead">
        I'm looking for a software engineering internship. Whether you have a role, a project, or just want to say hi,
        my inbox is open.
      </p>

      <div class="actions">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">✉️ {profile.email}</a>
        <button class="btn btn-ghost copy" id="copy-email" data-email={profile.email} type="button">
          <span class="copy-label">Copy email</span>
        </button>
        <a href={profile.github} class="btn btn-ghost" target="_blank" rel="noopener">
          github.com/{profile.githubHandle} ↗
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <p>© {year} {profile.name}. Built with Astro.</p>
    <a href="#top" class="to-top">Back to top ↑</a>
  </div>
</footer>

<style>
  .box {
    text-align: center;
    padding: clamp(40px, 8vw, 80px) clamp(22px, 6vw, 72px);
    background:
      radial-gradient(circle at 20% 0%, rgba(139, 92, 246, 0.22), transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(56, 189, 248, 0.18), transparent 50%), var(--surface);
  }

  .box .eyebrow {
    justify-content: center;
  }

  .lead {
    max-width: 560px;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 38px;
  }

  .copy {
    cursor: pointer;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .actions .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .footer {
    padding: 32px 0 40px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }

  .footer p {
    margin: 0;
  }

  .to-top:hover {
    color: var(--text);
  }
</style>

<script>
  const btn = document.getElementById('copy-email');
  const label = btn?.querySelector('.copy-label');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? '');
      if (label) label.textContent = 'Copied! ✓';
    } catch {
      if (label) label.textContent = 'Copy failed';
    }
    setTimeout(() => {
      if (label) label.textContent = 'Copy email';
    }, 2000);
  });
</script>
