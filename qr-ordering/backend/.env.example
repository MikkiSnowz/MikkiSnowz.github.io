# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://qr_user:qr_password@localhost:3306/qr_ordering

# --- Business settings ---
BUSINESS_NAME=My Local Cafe
CURRENCY=aud
# GST/VAT rate as a decimal. TAX_INCLUSIVE=true means menu prices already include tax
# (normal in Australia/NZ); false adds tax on top at checkout (normal in the US).
TAX_RATE=0.10
TAX_INCLUSIVE=true
# Optional surcharge on card payments, e.g. 0.015 for 1.5%. 0 disables it.
CARD_SURCHARGE_RATE=0
# Allow customers to choose "pay at the counter" instead of paying by card online.
ALLOW_PAY_AT_COUNTER=true

# --- URLs ---
# Where the React app is served. QR codes point here.
FRONTEND_URL=http://localhost:5173

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Staff/admin API ---
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Downstream system (POS / kitchen display / accounting) ---
# Confirmed orders are POSTed here as JSON. Leave empty to disable.
DOWNSTREAM_WEBHOOK_URL=
# Used to sign the payload (X-Signature header, HMAC-SHA256 of the raw body).
DOWNSTREAM_WEBHOOK_SECRET=change-me-too
